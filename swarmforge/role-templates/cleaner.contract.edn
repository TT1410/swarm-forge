{:role "cleaner"
 :handoff-targets ["squad-leader"]
 :may-web-search false
 :may-fetch-tools false
 :may-spawn false
 :may-talk-to-user false
 :required-tools [{:name "crap4clj" :source "github.com/unclebob/crap4clj" :version "latest" :purpose "CRAP"}
                  {:name "dry4clj" :source "github.com/unclebob/dry4clj" :version "latest" :purpose "DRY"}]
 :writes ["cleanup" "coverage-improvements"]
 :artifact-roots ["src/" "test/"]
 :behavior-preserving true}
