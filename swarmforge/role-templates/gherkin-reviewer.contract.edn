{:role "gherkin-reviewer"
 :handoff-targets ["squad-leader"]
 :may-web-search false
 :may-fetch-tools false
 :may-spawn false
 :may-talk-to-user false
 :may-run-broad-tests false
 :required-tool-ids ["gherkin-parser" "ir-dry-checker"]
 :writes ["review-report"]
 :artifact-roots [".squad/reviews/"]
 :forbidden-artifact-roots ["stories/" "features/" "qa/" "src/" "test/"]}
