{:role "analyst"
 :handoff-targets ["squad-leader"]
 :may-web-search true
 :may-fetch-tools false
 :may-spawn false
 :may-talk-to-user false
 :writes ["stories" "dependency-checker" "implementation-order"]
 :artifact-roots ["stories/"]
 :allowed-root-files ["dependency-checker.edn" "implementation-order.md"]
 :forbidden-artifact-roots ["features/" "qa/" "src/" "test/" "reviews/"]
 :self-contained-output true
 :requires-dependency-checker true
 :requires-implementation-order true}
